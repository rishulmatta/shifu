# Names only. Values go in .env.local (never committed) and in the Vercel project env.

# Meta Model API (https://dev.meta.ai): Muse Spark, Muse Voice Transcribe
META_MODEL_API_KEY=

# Baseten Model APIs: Muse Spark Open (meta-models/muse-spark-open-1026)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1

# Optional: a Modal Shared Endpoint for Muse Spark Open, the fallback after Baseten. The URL is the
# endpoint's URL from the Modal dashboard plus /v1; the token is a proxy token (Settings → Proxy
# Auth Tokens): its id starts wk-, its secret ws-.
MODAL_BASE_URL=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=

# Optional: YouTube Data API v3, the fallback for search when SearchAPI is not set
YOUTUBE_API_KEY=

# SearchAPI (searchapi.io): YouTube search and captions
SEARCHAPI_API_KEY=

# Postgres
DATABASE_URL=
