{
  "name": "shifu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "spike:plan": "node --env-file-if-exists=.env.local scripts/spikes/meta-plan.mts",
    "spike:baseten": "node --env-file-if-exists=.env.local scripts/spikes/baseten.mts",
    "spike:voice": "node --env-file-if-exists=.env.local scripts/spikes/voice.mts",
    "spike:modal": "node --env-file-if-exists=.env.local scripts/spikes/modal.mts",
    "spike:youtube": "node --env-file-if-exists=.env.local scripts/spikes/youtube.mts",
    "test": "vitest run",
    "try:plan": "tsx --env-file-if-exists=.env.local scripts/try-plan.mts",
    "try:clips": "tsx --env-file-if-exists=.env.local scripts/try-clips.mts",
    "try:build": "tsx --env-file-if-exists=.env.local scripts/try-build.mts"
  },
  "dependencies": {
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/youtube": "^0.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.6.0"
}
